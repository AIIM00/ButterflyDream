generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// Enums
// ======================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ADMIN_LOGIN
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_STATUS_CHANGED
  ORDER_CANCELLED
  ORDER_DELIVERED
  SYSTEM
}

enum InStoreSaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum InStorePaymentMethod {
  CASH
  CARD
  OTHER
}

enum InventoryMovementType {
  IN_STORE_SALE
  IN_STORE_SALE_CANCELLED
  IN_STORE_REFUND
  RESTOCK
  MANUAL_ADJUSTMENT
  DAMAGED
  RETURN
}

enum HomeSectionType {
  ANNOUNCEMENT_BAR
  OPENING_SLIDER
  TRANSFORMATION_STORY
  CATEGORIES
  FEATURED_PRODUCTS
  COLLECTIONS
  FEEDBACK
  IMAGE_TEXT
  IMAGE_BANNER
}
enum PopupEventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
// ======================================================
// Users and Authentication
// ======================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(30)
  passwordHash String     @db.VarChar(255)
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt    DateTime?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses          Address[]
  otpCodes           OtpCode[]
  cart               Cart?
  wishlist           Wishlist?
  orders             Order[]
  notifications      Notification[]
  feedbacks          Feedback[]
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")
  inStoreSales       InStoreSale[]        @relation("InStoreSaleRecordedBy")
  inventoryMovements InventoryMovement[]  @relation("InventoryMovementCreatedBy")
  popupEventsCreated   PopupEvent[]           @relation("PopupEventCreatedBy")
  popupEventLikes      PopupEventLike[]
  popupEventAttendances PopupEventAttendance[]
  popupEventComments   PopupEventComment[]
  @@index([role, status])
  @@index([status, createdAt])
}

model OtpCode {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  purpose      OtpPurpose
  codeHash     String     @db.VarChar(255)
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

// ======================================================
// Customer Addresses
// ======================================================

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  label         String   @db.VarChar(50)
  recipientName String   @db.VarChar(120)
  phone         String   @db.VarChar(30)
  governorate   String   @db.VarChar(100)
  city          String   @db.VarChar(120)
  street        String   @db.VarChar(255)
  building      String?  @db.VarChar(120)
  floor         String?  @db.VarChar(50)
  landmark      String?  @db.VarChar(255)
  notes         String?  @db.Text
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

// ======================================================
// Product Catalog
// ======================================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(140)
  description String? @db.Text

  imageUrl         String? @db.Text
  imageStorageKey  String? @unique
  imageContentType String? @db.VarChar(100)
  imageFileSize    Int?

  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@index([isActive, displayOrder])
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  name        String        @db.VarChar(180)
  slug        String        @unique @db.VarChar(200)
  description String        @db.Text
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  variants         ProductVariant[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  inStoreSaleItems InStoreSaleItem[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([status, createdAt])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  variantId String? @db.Uuid

  imageUrl    String  @db.Text
  storageKey  String? @unique
  contentType String?
  fileSize    Int?
  altText     String? @db.Text
  position    Int     @default(0)
  isPrimary   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([variantId])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  sku         String    @unique @db.VarChar(100)
  displayName String    @db.VarChar(180)
  options     Json
  price       Decimal   @db.Decimal(10, 2)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory        Inventory?
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  inStoreSaleItems InStoreSaleItem[]

  @@index([productId, isActive])
  @@index([productId, isDefault])
}

model Feedback {
  id String @id @default(cuid())

  rating Int

  comment String

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ======================================================
// Inventory
// ======================================================

model Inventory {
  id                String @id @default(uuid()) @db.Uuid
  variantId         String @unique @db.Uuid
  stockQuantity     Int    @default(0)
  lowStockThreshold Int    @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([stockQuantity])
}

// ======================================================
// In-Store Sales
// ======================================================

model InStoreSale {
  id               String  @id @default(uuid()) @db.Uuid
  saleNumber       String  @unique @db.VarChar(30)
  recordedByUserId String? @db.Uuid

  status        InStoreSaleStatus    @default(COMPLETED)
  paymentMethod InStorePaymentMethod
  currency      String               @default("USD") @db.Char(3)

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  customerName  String? @db.VarChar(120)
  customerPhone String? @db.VarChar(30)
  note          String? @db.Text

  soldAt      DateTime  @default(now())
  cancelledAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recordedBy User? @relation("InStoreSaleRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  items              InStoreSaleItem[]
  inventoryMovements InventoryMovement[]

  @@index([status, soldAt])
  @@index([paymentMethod, soldAt])
  @@index([recordedByUserId])
  @@index([soldAt])
}

model InStoreSaleItem {
  id     String @id @default(uuid()) @db.Uuid
  saleId String @db.Uuid

  productId String? @db.Uuid
  variantId String? @db.Uuid

  productName String @db.VarChar(180)
  variantName String @db.VarChar(180)
  sku         String @db.VarChar(100)
  options     Json

  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  sale InStoreSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
  @@index([variantId])
}

// ======================================================
// Inventory Movement History
// ======================================================

model InventoryMovement {
  id              String  @id @default(uuid()) @db.Uuid
  inventoryId     String  @db.Uuid
  inStoreSaleId   String? @db.Uuid
  createdByUserId String? @db.Uuid

  type InventoryMovementType

  quantityChange Int
  stockBefore    Int
  stockAfter     Int

  note      String?  @db.Text
  createdAt DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  inStoreSale InStoreSale? @relation(fields: [inStoreSaleId], references: [id], onDelete: SetNull)

  createdBy User? @relation("InventoryMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([inStoreSaleId])
  @@index([createdByUserId])
  @@index([type, createdAt])
}

// ======================================================
// Shopping Cart
// ======================================================

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id                String   @id @default(uuid()) @db.Uuid
  cartId            String   @db.Uuid
  variantId         String   @db.Uuid
  quantity          Int      @default(1)
  unitPriceSnapshot Decimal  @default(0) @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

// ======================================================
// Wishlist
// ======================================================

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

// ======================================================
// Orders
// ======================================================

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  orderNumber   String        @unique @db.VarChar(30)
  userId        String?       @db.Uuid
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(UNPAID)
  currency      String        @default("USD") @db.Char(3)

  subtotal       Decimal @db.Decimal(10, 2)
  deliveryFee    Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  customerNote String? @db.Text
  adminNote    String? @db.Text

  customerName  String @db.VarChar(120)
  customerEmail String @db.VarChar(255)
  customerPhone String @db.VarChar(30)

  deliveryRecipientName String  @db.VarChar(120)
  deliveryPhone         String  @db.VarChar(30)
  deliveryGovernorate   String  @db.VarChar(100)
  deliveryCity          String  @db.VarChar(120)
  deliveryStreet        String  @db.VarChar(255)
  deliveryBuilding      String? @db.VarChar(120)
  deliveryFloor         String? @db.VarChar(50)
  deliveryLandmark      String? @db.VarChar(255)
  deliveryNotes         String? @db.Text

  cancelledAt        DateTime?
  cancellationReason String?   @db.Text
  deliveredAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  notifications Notification[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  productId   String?  @db.Uuid
  variantId   String?  @db.Uuid
  productName String   @db.VarChar(180)
  variantName String   @db.VarChar(180)
  sku         String   @db.VarChar(100)
  options     Json
  imageUrl    String?  @db.Text
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  changedByUserId String?      @db.Uuid
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  note            String?      @db.Text
  createdAt       DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedByUserId])
}

// ======================================================
// Notifications
// ======================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  orderId   String?          @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(180)
  message   String           @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([orderId])
}

// ======================================================
// Store Configuration
// ======================================================

model StoreSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  storeName          String   @db.VarChar(160)
  supportEmail       String?  @db.VarChar(255)
  supportPhone       String?  @db.VarChar(30)
  currency           String   @default("USD") @db.Char(3)
  defaultDeliveryFee Decimal  @default(0) @db.Decimal(10, 2)
  ordersEnabled      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ======================================================
// Website Content / CMS
// ======================================================

model HomeSection {
  id        String          @id @default(uuid()) @db.Uuid
  type      HomeSectionType
  name      String          @db.VarChar(120)
  position  Int             @default(0)
  isEnabled Boolean         @default(true)

  // Section-specific content:
  // titles, descriptions, buttons, images, settings, etc.
  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled, position])
  @@index([type])
}

model MediaAsset {
  id String @id @default(uuid()) @db.Uuid

  fileName   String @db.VarChar(255)
  imageUrl   String @db.Text
  storageKey String @unique @db.Text

  contentType String @db.VarChar(100)
  fileSize    Int

  altText String? @db.VarChar(300)

  width  Int?
  height Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  popupEventImages PopupEventImage[]
  @@index([createdAt])
}

model SiteTheme {
  id String @id @default("default")

  // Website color palette
  colors Json

  // Display/body font configuration
  fonts Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SitePublication {
  id String @id @default("default")

  homepage Json
  theme    Json

  publishedAt        DateTime @default(now())
  publishedByUserId  String?  @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model PopupEvent {
  id              String           @id @default(uuid()) @db.Uuid
  title           String           @db.VarChar(160)
  location        String?          @db.VarChar(180)
  dateLabel       String?          @db.VarChar(80)
  caption         String           @db.Text

  status          PopupEventStatus @default(DRAFT)
  commentsEnabled Boolean          @default(true)
  position        Int              @default(0)

  createdByUserId String?          @db.Uuid
  publishedAt     DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy   User?                    @relation("PopupEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  images      PopupEventImage[]
  likes       PopupEventLike[]
  attendances PopupEventAttendance[]
  comments    PopupEventComment[]

  @@index([status, position])
  @@index([publishedAt])
  @@index([createdByUserId])
}

model PopupEventImage {
  id           String   @id @default(uuid()) @db.Uuid
  popupEventId String   @db.Uuid
  mediaAssetId String   @db.Uuid

  position     Int      @default(0)
  altText      String?  @db.VarChar(300)

  createdAt    DateTime @default(now())

  popupEvent PopupEvent @relation(fields: [popupEventId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([popupEventId, mediaAssetId])
  @@index([popupEventId, position])
  @@index([mediaAssetId])
}

model PopupEventLike {
  id           String   @id @default(uuid()) @db.Uuid
  popupEventId String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())

  popupEvent PopupEvent @relation(fields: [popupEventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /*
   * One like per customer per popup.
   */
  @@unique([popupEventId, userId])
  @@index([userId])
}

model PopupEventAttendance {
  id           String   @id @default(uuid()) @db.Uuid
  popupEventId String   @db.Uuid
  userId       String   @db.Uuid
  createdAt    DateTime @default(now())

  popupEvent PopupEvent @relation(fields: [popupEventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /*
   * A customer can confirm attendance only once.
   */
  @@unique([popupEventId, userId])
  @@index([userId])
}

model PopupEventComment {
  id           String   @id @default(uuid()) @db.Uuid
  popupEventId String   @db.Uuid
  userId       String   @db.Uuid
  body         String   @db.VarChar(1000)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  popupEvent PopupEvent @relation(fields: [popupEventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([popupEventId, createdAt])
  @@index([userId])
}