{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon",
    "admin:create-initial": "node scripts/createInitialAdmin.js",
    "r2:test": "node scripts/testR2.js",
    "build": "prisma generate",
    "test": "cross-env NODE_ENV=test DOTENV_CONFIG_PATH=.env.test vitest run --maxWorkers=1",
    "test:watch": "cross-env NODE_ENV=test DOTENV_CONFIG_PATH=.env.test vitest --maxWorkers=1",
    "test:db:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test:db:reset": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed",
    "email:test-transactional": "node scripts/testTransactionalEmail.js",
    "db-generate": "prisma generate",
    "db-validate": "prisma validate",
    "db-studio": "prisma studio",
    "db-migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db-status": "prisma migrate status",
    "db-seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
