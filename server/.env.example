PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/accessories_platform?schema=public
CLIENT_URL=http://localhost:5173
ALLOWED_FRONTEND_ORIGINS=http://localhost:5173

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUTH_SESSION_DAYS=7
AUTH_COOKIE_NAME=accessories_auth
AUTH_COOKIE_SAME_SITE=lax

ADMIN_NAME=Store Administrator
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

STORE_NAME=Your Accessories Store
DEFAULT_DELIVERY_FEE=0.00

OTP_HASH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

ADMIN_LOGIN_OTP_MINUTES=3
ADMIN_LOGIN_OTP_MAX_ATTEMPTS=5

EMAIL_VERIFICATION_OTP_MINUTES=3
EMAIL_VERIFICATION_OTP_MAX_ATTEMPTS=5

PASSWORD_RESET_OTP_MINUTES=5
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SENDER_EMAIL=your-email@example.com
EMAIL_PASSWORD=YOUR_EMAIL_APP_PASSWORD




TRUST_PROXY=false
REQUEST_BODY_LIMIT=250kb

API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX_REQUESTS=500

AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_REQUESTS=30

CHECKOUT_RATE_LIMIT_WINDOW_MINUTES=10
CHECKOUT_RATE_LIMIT_MAX_REQUESTS=20

ADMIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_RATE_LIMIT_MAX_REQUESTS=300